# Copy to .env and fill in the blanks - or run `bash scripts/init-env.sh`,
# which creates .env from this file with freshly generated random secrets.

# Database password (keep it URL-safe: it is embedded in DATABASE_URL)
POSTGRES_PASSWORD=
# Only used when running outside Docker (npm run dev)
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/ittracker

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Initial admin account, created on first start by scripts/seed-admin.js
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Password for the demo support/user accounts created by scripts/create-users.*
DEMO_PASSWORD=

# Optional outgoing webhooks - disabled unless BOTH are set
WEBHOOK_URL=
WEBHOOK_SECRET=

# Public live-demo mode: one-click demo logins and a data reset on every start (keep false locally)
DEMO_MODE=false

NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
